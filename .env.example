# --- control plane
PORT=3029
JWT_SECRET=change-me-to-a-long-random-string
SHOAL_PUBLIC_URL=http://localhost:3029
SHOAL_CONSOLE_URL=http://localhost:3029
CORS_ORIGINS=http://localhost:5173
# Token for CI pipelines (sent as "Authorization: Bearer <token>")
SHOAL_SERVICE_TOKEN=
# Optional Google sign-in (Google Cloud console → OAuth client ID, web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- cluster plumbing: sqlite (default, one host / shared volume) or kafka + redis
SHOAL_BUS=sqlite
SHOAL_LEASES=sqlite
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379

# --- data plane
SHOAL_ROLE=all
SHOAL_PEER_PORT=6881
SHOAL_DHT=on
SHOAL_DHT_PORT=6881
# e.g. router.bittorrent.com:6881 to join public swarms
SHOAL_DHT_BOOTSTRAP=
# address other workers should dial
SHOAL_ADVERTISE_HOST=
# extra announce URLs, comma separated
SHOAL_TRACKERS=

# --- tracing (OTLP/HTTP collector such as Tempo or Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=shoal
