{
  "title": "Swarmcast fleet",
  "uid": "swarmcast-fleet",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Fleet throughput (bytes/s)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "swarmcast_download_speed_bytes",
          "refId": "A",
          "legendFormat": "download"
        },
        {
          "expr": "swarmcast_upload_speed_bytes",
          "refId": "B",
          "legendFormat": "upload"
        }
      ]
    },
    {
      "id": 2,
      "title": "Workers",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "swarmcast_active_workers",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "title": "Directive lag (s)",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "swarmcast_queue_lag_seconds",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "title": "Bytes served from CAS",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum(swarmcast_cas_dedup_bytes_total)",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "Transfers by state",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "swarmcast_transfers",
          "refId": "A",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP requests/s",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(swarmcast_http_requests_total[1m]))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(swarmcast_http_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Leases acquired / lost",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "rate(swarmcast_lease_acquired_total[5m])",
          "refId": "A",
          "legendFormat": "acquired"
        },
        {
          "expr": "rate(swarmcast_lease_lost_total[5m])",
          "refId": "B",
          "legendFormat": "lost"
        }
      ]
    },
    {
      "id": 9,
      "title": "Idempotent replays",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "rate(swarmcast_idempotent_replays_total[5m])",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    }
  ]
}