# --- control plane
PORT=3029
JWT_SECRET=change-me-to-a-long-random-string
SWARMCAST_PUBLIC_URL=http://localhost:3029
SWARMCAST_CONSOLE_URL=http://localhost:3029
CORS_ORIGINS=http://localhost:5173
# Token for CI pipelines (sent as "Authorization: Bearer <token>")
SWARMCAST_SERVICE_TOKEN=
# Optional Google sign-in (Google Cloud console → OAuth client ID, web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- cluster plumbing: sqlite (default, one host / shared volume) or kafka + redis
SWARMCAST_BUS=sqlite
SWARMCAST_LEASES=sqlite
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379

# --- data plane
SWARMCAST_ROLE=all
SWARMCAST_PEER_PORT=6881
SWARMCAST_DHT=on
SWARMCAST_DHT_PORT=6881
# e.g. router.bittorrent.com:6881 to join public swarms
SWARMCAST_DHT_BOOTSTRAP=
# address other workers should dial
SWARMCAST_ADVERTISE_HOST=
# extra announce URLs, comma separated
SWARMCAST_TRACKERS=

# --- tracing (OTLP/HTTP collector such as Tempo or Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=swarmcast
